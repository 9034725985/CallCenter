@page "/"
@using CallCenter.Data.Model
@using Newtonsoft.Json
@inject IHttpClientFactory ClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Index> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Index</PageTitle>

<h1>Hello, @(userName)!</h1>

Welcome to your new app.

@if (allAnalytics.Any())
{
    <p>Last user interaction was recorded at @allAnalytics.OrderByDescending(x => x.Id).First().CreatedAt UTC. It is now @DateTime.UtcNow UTC</p>
}

<SurveyPrompt Title="Potatoes are good for health!" />

@code {
    private string userName = "guest!";
    private List<Analytics> allAnalytics = [];
    private string debugg = "";

    protected override async Task OnInitializedAsync()
    {
        await GetUsername();
        allAnalytics = await GetAnalytics();
        _ = SendAnalytics();
    }

    private async Task GetUsername()
    {
        AuthenticationState? authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userName = authState?.User?.Identity?.IsAuthenticated == true ? authState.User.Identity.Name! : "Guest";
    }

    private async Task SendAnalytics()
    {
        string? clientDateTime = await JSRuntime.InvokeAsync<string>("getClientDateTime");
        string dataKey = $"PageVisit-{clientDateTime}";
        string dataValue = userName == "Guest" ? "On IndexPage as Guest" : $"On IndexPage with {userName}";
        await PostAnalytics(dataKey, dataValue);
    }

    private async Task PostAnalytics(string key, string value)
    {
        try
        {
            AnalyticsData analyticsData = new Data.Model.AnalyticsData { DataKey = key, DataValue = value };
            HttpClient client = ClientFactory.CreateClient("public");
            HttpResponseMessage response = await client.PostAsJsonAsync("analytics", analyticsData);
            Logger.LogInformation(response.IsSuccessStatusCode ? "Analytics data created successfully." : $"Error creating analytics data: {response}");
        }
        catch { }
    }
    /// <summary>
    /// Get all analytics information
    /// </summary>
    /// <returns>List of all the analytics information</returns>
    private async Task<List<Analytics>> GetAnalytics()
    {
        // TODO: only get what we need
        try
        {
            HttpClient? client = ClientFactory.CreateClient("public");
            HttpResponseMessage? response = await client.GetAsync("analytics");

            if (response.IsSuccessStatusCode)
            {
                string? jsonString = await response.Content.ReadAsStringAsync();
                debugg = jsonString;
                List<Analytics> analyticsList = JsonConvert.DeserializeObject<List<Analytics>>(jsonString) ?? [];
                Logger.LogInformation("Analytics data created successfully.");
                return analyticsList ?? []; // Now you have a List<Analytics>
            }
            else
            {
                Logger.LogInformation($"Error creating analytics data: {response}");
                return []; // Or handle the error as needed
            }
        }
        catch (Exception ex)
        {
            Logger.LogError($"An error occurred: {ex.Message}");
            return []; // Or handle the exception as needed
        }
    }
}
